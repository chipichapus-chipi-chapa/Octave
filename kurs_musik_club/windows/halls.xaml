<Window x:Class="kurs_musik_club.windows.halls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs_musik_club.windows"
        mc:Ignorable="d"
        Title="halls" Height="830" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    <Window.Resources>
        <!-- Стиль для карточек услуг -->
        <Style x:Key="ServiceCard" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="320"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки -->
        <Style x:Key="OctaveRegisterButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#FF5722"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplate для карточки услуги -->
        <DataTemplate x:Key="ServiceCardTemplate">
            <Border Style="{StaticResource ServiceCard}">
                <StackPanel Margin="20">
                    <TextBlock HorizontalAlignment="Center" 
                               Text="{Binding Title}" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Description}" 
                               Foreground="#9E9E9E" 
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"/>
                    <Button Style="{StaticResource OctaveRegisterButton}" 
                            Content="заказать"
                            Command="{Binding DataContext.SelectServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Правая часть с формой -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,10">
                <Image Source="/img/octave-logo.png" Width="109" Margin="0,10,0,10" HorizontalAlignment="Left" Height="70"/>

                <TextBlock Text="Аренда залов" 
                          Foreground="White" 
                          FontSize="28" 
                          FontWeight="Bold"
                          Margin="0,0,0,30"/>
                <TextBlock Text="Наши залы оснащены современным и качественным оборудрванием" 
                          Foreground="#9E9E9E"
                          FontSize="18"
                          Height="57" Width="781"/>


                <TextBlock Text="Выберите зал:" 
                    Foreground="#9E9E9E"
                    FontSize="18"
                    Height="57" Width="780"/>

                <!-- Социальные сети -->
                <StackPanel Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </StackPanel>
                <Grid Height="286">
                    <Grid HorizontalAlignment="Left" Height="40" Margin="0,10,0,0" VerticalAlignment="Top" Width="389">
                        <ComboBox x:Name="cmbHalls" HorizontalAlignment="Left" Margin="60,0,0,0"
                          Style="{StaticResource OctaveComboBox}"
                          SelectionChanged="cmbHalls_SelectionChanged">
                            <ComboBoxItem Content="Зал 1"/>
                            <ComboBoxItem Content="Зал 2"/>
                            <ComboBoxItem Content="Зал 3"/>
                        </ComboBox>
                    </Grid>
                    <Grid HorizontalAlignment="Left" Height="214" Margin="458,10,0,0" VerticalAlignment="Top" Width="412">
                        <Image x:Name="hallImage" Source="/img/octave-logo.png" Width="200" Height="120" Margin="0,10,0,10" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="hallDescription" Margin="0,140,0,40" Text="Описание зала будет загружено при выборе" Foreground="#9E9E9E" FontSize="18" TextWrapping="Wrap"/>
                    </Grid>
                    <Button x:Name="btn_reg" Content="ЗАБРОНИРОВАТЬ" Width="200"
                            Style="{StaticResource OctaveRegisterButton}" 
                            Margin="350,193,338,62"
                            Click="btn_reg_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
