<Window x:Class="kurs_musik_club.windows.EditEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:kurs_musik_club.converters"
        Title="Редактирование оборудования" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF2D2D30">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="SmallComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Width" Value="150"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Тип оборудования:" Grid.Row="0"/>
        <ComboBox x:Name="typeComboBox" Grid.Row="1" SelectionChanged="TypeComboBox_SelectionChanged"/>

        <TextBlock Text="Бренд:" Grid.Row="2"/>
        <ComboBox x:Name="brandComboBox" Grid.Row="3"/>

        <TextBlock Text="Состояние:" Grid.Row="4"/>
        <ComboBox x:Name="conditionComboBox" Grid.Row="5"/>

        <TextBlock Text="Доступность:" Grid.Row="6"/>
        <ComboBox x:Name="availabilityComboBox" 
                  Grid.Row="7" 
                  Style="{StaticResource SmallComboBox}"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="CancelButton_Click"/>
            <Button Content="Сохранить" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 