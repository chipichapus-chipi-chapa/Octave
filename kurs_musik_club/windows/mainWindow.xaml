<Window x:Class="kurs_musik_club.windows.mainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs_musik_club.windows"
        Title="Octave Music Club" 
        Height="700" Width="1200"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.Resources>
        <!-- Стиль для карточек услуг -->
        <Style x:Key="ServiceCard" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="350"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок навигации -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок действий -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Width="100" Height="20">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для заголовков секций -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,25"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель навигации -->
        <Border Grid.Column="0" 
                Background="#1E1E1E" 
                Width="86">
            <StackPanel Margin="10">
                <Button x:Name="profileButton" 
                        Content="👤" 
                        Style="{StaticResource NavButton}"
                        Click="ProfileButton_Click"
                        ToolTip="Профиль"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Column="1" 
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,-100">
            <StackPanel Margin="40">
                <!-- Приветственная секция -->
                <Border Background="#FF5722" 
                        CornerRadius="15" 
                        Height="250" 
                        Margin="0,0,0,30">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" 
                                  Margin="40">
                            <TextBlock Text="Welcome to Octave!" 
                                     Foreground="White" 
                                     FontSize="42" 
                                     FontWeight="Bold"/>
                            <TextBlock Text="Твоё музыкальное пространство для творчества" 
                                     Foreground="#E0E0E0" 
                                     FontSize="18" 
                                     Margin="0,15,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Быстрый доступ -->
                <TextBlock Text="Быстрый доступ" 
                         Style="{StaticResource SectionTitle}" 
                         HorizontalAlignment="Center"/>

                <WrapPanel HorizontalAlignment="Center" 
                          Width="1000">
                    <Border Style="{StaticResource ServiceCard}">
                        <StackPanel Margin="25">
                            <TextBlock Text="Студия записи" 
                                     Foreground="White" 
                                     FontSize="20" 
                                     FontWeight="SemiBold"/>
                            <TextBlock Text="Профессиональная запись и сведение" 
                                     Foreground="#9E9E9E" 
                                     Margin="0,10,0,0"
                                     TextWrapping="Wrap"/>
                            <Button x:Name="btn_rec" 
                                    Content="Забронировать" 
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Left"
                                    Click="btn_rec_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ServiceCard}">
                        <StackPanel Margin="25">
                            <TextBlock Text="Аренда залов" 
                                     Foreground="White" 
                                     FontSize="20" 
                                     FontWeight="SemiBold"/>
                            <TextBlock Text="Репетиционные залы с оборудованием" 
                                     Foreground="#9E9E9E" 
                                     Margin="0,10,0,0"
                                     TextWrapping="Wrap"/>
                            <Button x:Name="rent_halls" 
                                    Content="Выбрать зал" 
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Left"
                                    Click="rent_halls_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ServiceCard}">
                        <StackPanel Margin="25">
                            <TextBlock Text="Музыкальные курсы" 
                                     Foreground="White" 
                                     FontSize="20" 
                                     FontWeight="SemiBold"/>
                            <TextBlock Text="Обучение у профессионалов" 
                                     Foreground="#9E9E9E" 
                                     Margin="0,10,0,0"
                                     TextWrapping="Wrap"/>
                            <Button x:Name="btn_muz_curs" 
                                    Content="Выбрать курс" 
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Left"
                                    Click="btn_muz_curs_Click"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Предстоящие мероприятия -->

                <ItemsControl ItemsSource="{Binding UpcomingEvents}" 
                            Margin="0,0,0,30">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E1E1E" 
                                    CornerRadius="12" 
                                    Margin="0,0,0,20" 
                                    Padding="25">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding Image}" 
                                           Width="140" 
                                           Height="140" 
                                           Grid.Column="0"/>

                                    <StackPanel Grid.Column="1" 
                                                Margin="25,0">
                                        <TextBlock Text="{Binding Title}" 
                                                 Foreground="White" 
                                                 FontSize="20" 
                                                 FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Date}" 
                                                 Foreground="#FF5722" 
                                                 Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding Description}" 
                                                 Foreground="#9E9E9E" 
                                                 Margin="0,10,0,0" 
                                                 TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Content="Купить билет" 
                                            Grid.Column="2" 
                                            Style="{StaticResource ActionButton}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
