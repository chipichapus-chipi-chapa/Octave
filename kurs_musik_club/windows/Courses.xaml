<Window x:Class="kurs_musik_club.windows.Courses"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs_musik_club.windows"
        mc:Ignorable="d"
        Title="Courses" Height="750" Width="880"
         Background="#121212">
    <Window.Resources>
        <!-- Стиль для кнопки -->
        <Style x:Key="OctaveRegisterButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#FF5722"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="0,0,0,49">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" MinHeight="214"/>
            <RowDefinition/>
            <RowDefinition Height="0*"/>


        </Grid.RowDefinitions>
        <Image Source="/img/octave-logo.png" Width="109" Margin="0,0,0,30" HorizontalAlignment="Left" d:IsLocked="True"/>

        <TextBlock Text="Octave - простраство для обучения" 
             Foreground="White" 
             FontSize="28"
             FontWeight="Bold"
             Margin="120,50,0,30"/>

        <TextBlock Text="Выберите курс:" 
         Foreground="#9E9E9E"
         FontSize="18"
         Margin="120,100,125,39" />
        <StackPanel Grid.Row="0" Margin="10,119,525,12">
            <TextBlock Text="Поиск курсов:" Margin="0,0,0,5" FontSize="14" FontWeight="SemiBold"/>
            <TextBox x:Name="SearchTextBox" 
                     TextChanged="SearchTextBox_TextChanged"
                     Padding="5"
                     FontSize="14"
                     BorderThickness="1"
                     BorderBrush="#CCCCCC"
                     Background="White" Height="36" RenderTransformOrigin="0.5,0.5" Width="305">
                <TextBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TextBox.RenderTransform>
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </StackPanel>


        <ListView x:Name="listViewcards" Margin="10,199,10,11" Background="#FF121212" BorderBrush="#FF121212" Grid.RowSpan="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="White" BorderThickness="1" Margin="5" CornerRadius="10">
                        <Grid Margin="10" Width="750">
                            <Grid.ContextMenu>
                                <ContextMenu >
                                    <MenuItem Header="Подробнее о курсе" Click="MenuItem_Details_Click"/>
                                    <MenuItem Header="Записаться на курс" Click="MenuItem_Enroll_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding name_course}" 
                                     FontSize="18" 
                                     FontWeight="Bold"
                                     Foreground="White"
                                     Margin="10,10,10,5"/>
                            <StackPanel Grid.Row="1" Margin="10,5,10,10">
                                <TextBlock Text="{Binding description}" 
                                         TextWrapping="Wrap"
                                         Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding teacher_name}" 
                                         Margin="0,5,0,0"
                                         Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding duration, StringFormat='Длительность: {0} часов'}" 
                                         Margin="0,5,0,0"
                                         Foreground="#CCCCCC"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
