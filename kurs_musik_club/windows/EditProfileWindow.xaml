<Window x:Class="kurs_musik_club.windows.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование профиля" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.Resources>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Имя" 
                       Foreground="White" 
                       FontSize="16"
                       Margin="0,0,0,5"/>
            
            <TextBox x:Name="userName" 
                     Style="{StaticResource InputField}"/>
            
            <TextBlock Text="Email" 
                       Foreground="White" 
                       FontSize="16"
                       Margin="0,0,0,5"/>
            
            <TextBox x:Name="userEmail" 
                     Style="{StaticResource InputField}"/>
            
            <TextBlock Text="Новый пароль" 
                       Foreground="White" 
                       FontSize="16"
                       Margin="0,0,0,5"/>
            
            <PasswordBox x:Name="newPassword" 
                         Style="{StaticResource InputField}"/>
            
            <TextBlock Text="Подтверждение пароля" 
                       Foreground="White" 
                       FontSize="16"
                       Margin="0,0,0,5"/>
            
            <PasswordBox x:Name="confirmPassword" 
                         Style="{StaticResource InputField}"/>
            
            <Button x:Name="saveButton"
                    Content="Сохранить изменения"
                    Style="{StaticResource SaveButton}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 