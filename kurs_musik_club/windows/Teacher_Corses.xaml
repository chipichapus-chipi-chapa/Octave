<Window x:Class="kurs_musik_club.windows.Teacher_Corses"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs_musik_club.windows"
        mc:Ignorable="d"
        Title="Курсы преподавателя" Height="750" Width="1000"
        Background="#121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои курсы" 
                 Foreground="White" 
                 FontSize="24" 
                 FontWeight="Bold"
                 Margin="20,20,0,20"/>

        <ListView x:Name="coursesListView" Grid.Row="1" Margin="20">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="White" BorderThickness="1" Margin="5">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding name_course}" 
                                     FontSize="18" 
                                     FontWeight="Bold"
                                     Foreground="White"/>
                            <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                <TextBlock Text="{Binding description}" 
                                         TextWrapping="Wrap"
                                         Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding duration, StringFormat='Длительность: {0} часов'}" 
                                         Margin="0,5,0,0"
                                         Foreground="#CCCCCC"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window> 