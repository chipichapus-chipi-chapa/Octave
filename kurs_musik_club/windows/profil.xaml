<Window x:Class="kurs_musik_club.windows.profil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs_musik_club.windows"
        mc:Ignorable="d"
        Title="Профиль" Height="800" Width="1335"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7043"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#252525"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2A2A"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333333"/>
            <Setter Property="VerticalGridLinesBrush" Value="#333333"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" 
                                BorderThickness="0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#252525" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" 
                                ShadowDepth="0" 
                                Color="#000000" 
                                Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Профиль пользователя" 
                             Foreground="White"
                             FontSize="24"
                             FontWeight="Bold"
                             Margin="0,0,0,10"/>
                    <TextBlock x:Name="userName" 
                             Foreground="#E0E0E0"
                             FontSize="20"
                             Margin="0,5"/>
                    <TextBlock x:Name="userLogin" 
                             Foreground="#E0E0E0"
                             FontSize="16"
                             Margin="0,5"/>
                    <TextBlock x:Name="userRoleText" 
                             Foreground="#FF5722"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Margin="0,5"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Редактировать профиль" 
                            Click="EditProfileButton_Click"/>
                    <Button Content="Арендовать оборудование" 
                            Click="RentEquipmentButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <!-- Admin Content -->
            <Grid x:Name="adminContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="Управление пользователями" 
                            Click="manageUsersButton_Click"/>
                    <Button Content="Управление курсами" 
                            Click="manageCoursesButton_Click"/>
                    <Button Content="Управление оборудованием" 
                            Click="manageEquipmentButton_Click"/>
                </StackPanel>

                <!-- Users Management Grid -->
                <Grid x:Name="usersManagementGrid" Grid.Row="1">
                    <DataGrid x:Name="usersDataGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                              Binding="{Binding id_user}" 
                                              Width="50"/>
                            <DataGridTextColumn Header="Логин" 
                                              Binding="{Binding login}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="ФИО" 
                                              Binding="{Binding full_name}" 
                                              Width="300"/>
                            <DataGridTextColumn Header="Роль" 
                                              Binding="{Binding role}" 
                                              Width="150"/>
                            <DataGridTemplateColumn Width="400">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Изменить роль" 
                                                    Click="EditUserRole_Click"
                                                    Tag="{Binding id_user}"/>
                                            <Button Content="Удалить" 
                                                    Background="#FF0000"
                                                    Click="DeleteUser_Click"
                                                    Tag="{Binding id_user}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Courses Management Grid -->
                <Grid x:Name="coursesManagementGrid" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="Добавить курс" 
                                Click="AddCourse_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="coursesDataGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                              Binding="{Binding id_course}" 
                                              Width="50"/>
                            <DataGridTextColumn Header="Название" 
                                              Binding="{Binding name_course}" 
                                              Width="200"/>
                            <DataGridTextColumn Header="Преподаватель" 
                                              Binding="{Binding teacher_name}" 
                                              Width="200"/>
                            <DataGridTextColumn Header="Длительность" 
                                              Binding="{Binding duration}" 
                                              Width="100"/>
                            <DataGridTextColumn Header="Стоимость" 
                                              Binding="{Binding cost}" 
                                              Width="100"/>
                            <DataGridTemplateColumn Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Изменить" 
                                                    Click="EditCourse_Click"
                                                    Tag="{Binding id_course}"/>
                                            <Button Content="Удалить" 
                                                    Background="#FF0000"
                                                    Click="DeleteCourse_Click"
                                                    Tag="{Binding id_course}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                

                <!-- Equipment Management Grid -->
                <Grid x:Name="equipmentManagementGrid" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Button Content="Добавить оборудование" 
Click="AddEquipment_Click"/>
                    </StackPanel>

                 

                    <DataGrid x:Name="equipmentDataGrid" 
                            Grid.Row="1"
                            SelectionChanged="EquipmentDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                              Binding="{Binding id_musical_equipment}" 
                                              Width="50"/>
                            <DataGridTextColumn Header="Тип" 
                                              Binding="{Binding name_type_musical_equipment}" 
                                              Width="150"/>
                            <DataGridTextColumn Header="Бренд" 
                                              Binding="{Binding brand_musical_equipment}" 
                                              Width="150"/>
                            
                            <DataGridTextColumn Header="Стоимость в час" 
                                              Binding="{Binding cost_hour, StringFormat={}{0:C}}" 
                                              Width="120"/>
                            <DataGridTextColumn Header="ID арендатора" 
                                              Binding="{Binding id_user}" 
                                              Width="100"/>
                            <DataGridTemplateColumn Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Изменить" 
                                                    Click="EditEquipment_Click"/>
                                            <Button Content="Удалить" 
                                                    Background="#FF0000"
                                                    Click="DeleteEquipment_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                   
                </Grid>
            </Grid>

            <!-- Teacher Content -->
            <Grid x:Name="teacherContents" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Мои курсы" 
                         Foreground="White"
                         FontSize="24"
                         FontWeight="Bold"
                         Margin="0,0,0,10"/>

                <DataGrid x:Name="teacherCoursesList" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название курса" 
                                          Binding="{Binding name_course}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Длительность (часов)" 
                                          Binding="{Binding duration}" 
                                          Width="150"/>
                        <DataGridTextColumn Header="Количество студентов" 
                                          Binding="{Binding students_count}" 
                                          Width="150"/>
                        <DataGridTextColumn Header="Стоимость (руб/час)" 
                                          Binding="{Binding cost_hour}" 
                                          Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Client Content -->
            <Grid x:Name="clientContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- My Courses -->
                <TextBlock Text="Мои курсы" 
                         Foreground="White"
                         FontSize="24"
                         FontWeight="Bold"
                         Margin="0,0,0,10"
                         Grid.Row="0"/>

                <DataGrid x:Name="clientCoursesList" 
                         Grid.Row="1"
                         Margin="0,0,0,20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название курса" 
                                          Binding="{Binding name_course}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Преподаватель" 
                                          Binding="{Binding teacher_name}" 
                                          Width="200"/>
                        <DataGridTextColumn Header="Дата записи" 
                                          Binding="{Binding rent_date}" 
                                          Width="150"/>
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Отменить запись" 
                                            Click="UnenrollCourse_Click"
                                            Tag="{Binding id_rent_course}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Rented Halls -->
                <TextBlock Text="Арендованные залы" 
                         Foreground="White"
                         FontSize="24"
                         FontWeight="Bold"
                         Margin="0,0,0,10"
                         Grid.Row="2"/>

                <DataGrid x:Name="rentedHallsList" 
                         Grid.Row="3"
                         Margin="0,0,0,20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название зала" 
                                          Binding="{Binding name_hall}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Дата аренды" 
                                          Binding="{Binding rent_date, StringFormat=dd.MM.yyyy}" 
                                          Width="100"/>
                        <DataGridTextColumn Header="Время начала" 
                                          Binding="{Binding start_time, StringFormat=HH:mm}" 
                                          Width="100"/>
                        <DataGridTextColumn Header="Время окончания" 
                                          Binding="{Binding end_time, StringFormat=HH:mm}" 
                                          Width="100"/>
                        <DataGridTextColumn Header="Цель аренды" 
                                          Binding="{Binding purpose}" 
                                          Width="*"/>
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Отменить аренду" 
                                            Click="CancelRent_Click"
                                            Tag="{Binding id_rental}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Rented Equipment -->
                <TextBlock Text="Арендованное оборудование" 
                         Foreground="White"
                         FontSize="24"
                         FontWeight="Bold"
                         Margin="0,0,0,10"
                         Grid.Row="4"/>


                <DataGrid x:Name="rentedEquipmentList" 
                         Grid.Row="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Оборудование" 
                                          Binding="{Binding equipment_name}" 
                                          Width="*"/>
                        <DataGridTextColumn Header="Бренд" 
                                          Binding="{Binding type_name}" 
                                          Width="*"/>
                        
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Отменить аренду" 
                                            Click="CancelEquipmentRent_Click"
                                            Tag="{Binding id_rent_mus_eq}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
