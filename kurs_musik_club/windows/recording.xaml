<Window x:Class="kurs_musik_club.windows.recording"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs_musik_club.windows"
        mc:Ignorable="d"
        Title="recording" Height="555" Width="810"
        Background="#121212">
    <Window.Resources>
        <!-- Стиль для кнопки -->
        <Style x:Key="OctaveRegisterButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#FF5722"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточек -->
        <Style x:Key="CourseCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="0,0,0,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" MinHeight="148"/>
            <RowDefinition/>


        </Grid.RowDefinitions>
        <Image Source="/img/octave-logo.png" Width="109" Margin="0,0,0,0" HorizontalAlignment="Left" d:IsLocked="True"/>

        <TextBlock Text="Запись и мастеринг Ваших треков" 
               Foreground="White" 
               FontSize="28" 
               FontWeight="Bold"
               Margin="120,50,0,30"/>

        <TextBlock Text="Выберите услугу:" 
           Foreground="#9E9E9E"
           FontSize="18"
           Margin="120,100,125,39" />

        <ListView x:Name="listViewcards" Grid.Row="1" Margin="10,10,10,10" Background="#FF121212" BorderBrush="#FF121212" Loaded="listViewcards_Loaded">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="White" BorderThickness="1" Margin="5" CornerRadius="10">
                        <Grid Margin="10" Width="700">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="auto"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="{Binding name_rec}" 
                                         FontSize="18" 
                                         FontWeight="Bold"
                                         Foreground="White"
                                         Margin="10,10,10,5"/>
                                <StackPanel Margin="10,5,10,10">
                                    <TextBlock Text="{Binding price, StringFormat='Стоимость: {0} руб'}" 
                                             Foreground="#CCCCCC"/>

                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <Button x:Name="btnBook" Content="ЗАКАЗАТЬ" Width="NaN"
                Style="{StaticResource OctaveRegisterButton}" 
                Margin="274,251,305,30"
                Grid.Row="1"
                Click="btnBook_Click"/>
    </Grid>

</Window>
