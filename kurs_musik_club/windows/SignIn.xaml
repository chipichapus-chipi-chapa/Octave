<Window x:Class="kurs_musik_club.windows.SignIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kurs_musik_club.windows"
        Title="Вход в Octave" 
        Height="830" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Стиль для кнопок социальных сетей -->
        <Style x:Key="SocialButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="5" 
                                    BorderBrush="#333333"
                                    BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Стиль для кнопки входа -->
        <Style x:Key="OctaveLoginButton" TargetType="Button">
            <Setter Property="Content" Value="ВОЙТИ"/>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="OctaveTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" 
                                         Foreground="#9E9E9E"
                                         Margin="10,0,0,0"
                                         VerticalAlignment="Center"
                                         FontSize="{TemplateBinding FontSize}"
                                         Visibility="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                <ScrollViewer x:Name="PART_ContentHost" 
                                            Margin="10,12"
                                            VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF5722"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для пароля -->
        <Style x:Key="MateriaPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#424242"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4" 
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" 
                                         Foreground="#9E9E9E"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         FontSize="{TemplateBinding FontSize}"
                                         Visibility="{Binding Password.Length, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                <ScrollViewer x:Name="PART_ContentHost" 
                                            Margin="8,10"
                                            VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF5722"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ссылки "Забыли пароль?" -->
        <Style x:Key="ForgotPasswordLink" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,5,0,20"/>
        </Style>

        <!-- Стиль для кнопки регистрации -->
        <Style x:Key="OctaveRegisterButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#FF5722"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть с изображением -->
        <Border Grid.Column="0" Width="400" Background="#1A1A1A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/img/tg.jpg" Margin="0,10,0,10" HorizontalAlignment="Center" Height="318" Width="332"/>
                <TextBlock Text="С возвращением в музыкальное сообщество" 
                           Foreground="#9E9E9E"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Width="300"/>
            </StackPanel>
        </Border>

        <!-- Правая часть с формой -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="60">
            <Image Source="/img/octave-logo.png" Width="109" Margin="0,0,0,30" HorizontalAlignment="Left" Height="70"/>

            <TextBlock Text="Вход в аккаунт" 
                       Foreground="White" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Margin="0,0,0,30"/>

            <!-- Форма входа -->
            <StackPanel Width="300">
                <TextBox x:Name="txtEmail" 
                         Tag="Логин" 
                         Style="{StaticResource OctaveTextBox}"/>

                <PasswordBox x:Name="txtPassword" 
                            Tag="Пароль" 
                            Style="{StaticResource MateriaPasswordBox}"/>

                <TextBlock Style="{StaticResource ForgotPasswordLink}">
                    <Underline>Забыли пароль?</Underline>
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding ForgotPasswordCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <Button x:Name="btn_sing_in" 
                        Content="ВОЙТИ"
                        Style="{StaticResource OctaveRegisterButton}" 
                        Click="btn_sing_in_Click"/>

                <CheckBox x:Name="chkRemember" 
                          Content="Запомнить меня"
                          Foreground="#9E9E9E"
                          Margin="0,15,0,0"/>

                <TextBlock x:Name="txt_reg" 
                           Text="Ещё нет аккаунта? Зарегистрироваться" 
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"
                           Cursor="Hand" 
                           MouseLeftButtonDown="txt_reg_MouseLeftButtonDown">
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding RegisterCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <!-- Разделитель -->
                <StackPanel Orientation="Horizontal" Margin="0,40,0,20" HorizontalAlignment="Center">
                    <Line X1="0" Y1="0" X2="100" Y2="0" Stroke="#333333" StrokeThickness="1" Stretch="Fill"/>
                    <TextBlock Text="или" Foreground="#9E9E9E" Margin="10,0"/>
                    <Line X1="0" Y1="0" X2="100" Y2="0" Stroke="#333333" StrokeThickness="1" Stretch="Fill"/>
                </StackPanel>

                <!-- Социальные сети -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="google_btn"  
                               Style="{StaticResource SocialButton}" 
                               Content="Google" 
                               Margin="0,0,10,0"
                               Click="GoogleLogin_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4285F4" Offset="0"/>
                                    <GradientStop Color="#34A853" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        <Button x:Name="VKbtn"  
                               Style="{StaticResource SocialButton}" 
                               Content="VK"
                               Click="VKLogin_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4C75A3" Offset="0"/>
                                    <GradientStop Color="#2B5876" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        <Button Style="{StaticResource SocialButton}" 
                               Content="Apple" 
                               Margin="10,0,0,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#000000" Offset="0"/>
                                    <GradientStop Color="#333333" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window> 