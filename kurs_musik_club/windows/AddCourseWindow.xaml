<Window x:Class="kurs_musik_club.windows.AddCourseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить новый курс" Height="600" Width="615"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.Resources>
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="DescriptionField" TargetType="TextBox" BasedOn="{StaticResource InputField}">
            <Setter Property="Height" Value="100"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Название курса" 
                       Foreground="White" 
                       FontSize="16"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="courseName" 
                     Style="{StaticResource InputField}"/>

            <TextBlock Text="Описание курса" 
                       Foreground="White" 
                       FontSize="16"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="courseDescription" 
                     Style="{StaticResource DescriptionField}"/>

            <TextBlock Text="Цена курса" 
                       Foreground="White" 
                       FontSize="16"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="coursePrice" 
                     Style="{StaticResource InputField}"/>

            <TextBlock Text="Преподаватель" 
                       Foreground="White" 
                       FontSize="16"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="teacherComboBox" 
                     Style="{StaticResource ComboBoxStyle}"
                     DisplayMemberPath="fio" SelectionChanged="teacherComboBox_SelectionChanged"/>

            <Button x:Name="addButton"
                    Content="Добавить курс"
                    Style="{StaticResource AddButton}"
                    Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</Window> 