<Window x:Class="kurs_musik_club.windows.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    <Window.Resources>
        <Style x:Key="SocialButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="5" 
                                    BorderBrush="#333333"
                                    BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Войти через социальные сети" 
                     Foreground="White" 
                     FontSize="24" 
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,30"/>
            
            <Button Content="Войти через ВКонтакте" 
                    Style="{StaticResource SocialButton}"
                    Click="VKLogin_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4C75A3" Offset="0"/>
                        <GradientStop Color="#2B5876" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            
            <Button Content="Войти через Google" 
                    Style="{StaticResource SocialButton}"
                    Click="GoogleLogin_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4285F4" Offset="0"/>
                        <GradientStop Color="#34A853" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>
    </Grid>
</Window> 