<Window x:Class="kurs_musik_club.windows.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    <Window.Resources>
        <Style x:Key="ProfileText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="ProfileButton" TargetType="Button">
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с информацией о пользователе -->
        <Border Grid.Column="0" Background="#1A1A1A" Padding="20">
            <StackPanel>
                <Image x:Name="userImage" 
                       Width="150" 
                       Height="150" 
                       Margin="0,0,0,20"
                       Source="/Resources/default_avatar.png"/>

                <TextBlock x:Name="userName" 
                           Style="{StaticResource ProfileText}"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock x:Name="userLogin" 
                           Style="{StaticResource ProfileText}"/>

                <TextBlock x:Name="userRole" 
                           Style="{StaticResource ProfileText}"
                           Foreground="#FF5722"/>

                <Button x:Name="editProfileButton"
                        Content="Редактировать профиль"
                        Style="{StaticResource ProfileButton}"
                        Click="editProfileButton_Click"/>

                <!-- Кнопки администратора -->
                <StackPanel x:Name="adminButtons" Visibility="Collapsed">
                    <Button x:Name="manageUsersButton"
                            Content="Управление пользователями"
                            Style="{StaticResource AdminButton}"
                            Click="manageUsersButton_Click"/>
                    
                    <Button x:Name="manageCoursesButton"
                            Content="Управление курсами"
                            Style="{StaticResource AdminButton}"
                            Click="manageCoursesButton_Click"/>
                    
                    <Button x:Name="manageBookingsButton"
                            Content="Управление бронированиями"
                            Style="{StaticResource AdminButton}"
                            Click="manageBookingsButton_Click"/>
                    
                    <Button x:Name="manageHallsButton"
                            Content="Управление залами"
                            Style="{StaticResource AdminButton}"
                            Click="manageHallsButton_Click"/>
                    
                    <Button x:Name="reportsButton"
                            Content="Отчеты"
                            Style="{StaticResource AdminButton}"
                            Click="reportsButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Правая панель с контентом -->
        <ScrollViewer Grid.Column="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Приветственная секция -->
                <Border Background="#FFA90606" CornerRadius="10" Height="232" Width="885" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="40">
                            <TextBlock Text="Профиль" 
                                       Foreground="White" 
                                       FontSize="35" FontFamily="Old English Text MT"/>
                            <TextBlock Text="Управление вашим аккаунтом" 
                                       Foreground="#E0E0E0" 
                                       FontSize="16" 
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Информация о пользователе -->
                <Border Background="#1E1E1E" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ФИО:" 
                                       Foreground="#9E9E9E" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Логин:" 
                                       Foreground="#9E9E9E" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Роль:" 
                                       Foreground="#9E9E9E" 
                                       Margin="0,0,0,5"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="FioTextBlock" 
                                       Text="{Binding UserFio}" 
                                       Foreground="White" 
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="LoginTextBlock" 
                                       Text="{Binding UserLogin}" 
                                       Foreground="White" 
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="RoleTextBlock" 
                                       Text="{Binding UserRole}" 
                                       Foreground="White" 
                                       Margin="0,0,0,5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Секция для администратора -->
                <Border x:Name="adminSection" 
                        Background="#1E1E1E" 
                        CornerRadius="10" 
                        Padding="20" 
                        Margin="0,0,0,20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Панель администратора" 
                                   Foreground="White" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Статистика -->
                            <Border Grid.Column="0" 
                                    Grid.Row="0" 
                                    Background="#2D2D2D" 
                                    CornerRadius="5" 
                                    Padding="15" 
                                    Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Статистика" 
                                               Foreground="White" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="totalUsersText" 
                                               Text="Всего пользователей: 0" 
                                               Foreground="#9E9E9E"/>
                                    <TextBlock x:Name="totalCoursesText" 
                                               Text="Всего курсов: 0" 
                                               Foreground="#9E9E9E"/>
                                    <TextBlock x:Name="totalBookingsText" 
                                               Text="Всего бронирований: 0" 
                                               Foreground="#9E9E9E"/>
                                </StackPanel>
                            </Border>

                            <!-- Последние действия -->
                            <Border Grid.Column="1" 
                                    Grid.Row="0" 
                                    Background="#2D2D2D" 
                                    CornerRadius="5" 
                                    Padding="15" 
                                    Margin="10,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Последние действия" 
                                               Foreground="White" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Margin="0,0,0,10"/>
                                    <ListView x:Name="recentActionsList" 
                                              Background="Transparent" 
                                              BorderThickness="0">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" 
                                                           Foreground="#9E9E9E" 
                                                           Margin="0,5"/>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window> 